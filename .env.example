# Agentic Coding Fitness — environment template.
#
#   cp .env.example .env        # then fill in ONLY the keys for the weeks you are doing
#
# .env is gitignored. Never commit a real key, and never paste one into code, a notebook or a
# screenshot. Every variable below is read by code in this repo; the comment says which weeks use it.
# Most labs also run without keys: $0 / DRY / SIM modes, or a local model through Ollama.
# Some weeks have their own template too: week06_fullstack_agent_app/, week10_production_observability/, week15_production_graphrag/code/, week23_open_superintelligence_stack/, week24_typed_decisions_jev/, week25_dgx_spark/.

# ── The one most weeks need ───────────────────────────────────────────────────
# Claude — weeks 2–5, 9–11, 14, 15, 17–19, 24, 25. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ── Other model providers (optional; each week says which it supports) ────────
# OpenRouter — many models behind one key, incl. free routes. Weeks 4, 9, 10, 24, agentic robotics.
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OpenAI — weeks 9, 15, 18, 19, 24, 25. https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Google Gemini — GOOGLE_API_KEY for ADK / LangChain (weeks 10, 15, 17–19), GEMINI_API_KEY for week 18/24.
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_API_KEY=
# DeepSeek, Kimi (Moonshot), GLM (Z.ai) — week 24's LLM picker; ZAI also week 9.
DEEPSEEK_API_KEY=
KIMI_API_KEY=
ZAI_API_KEY=
# Poe — week 7. https://poe.com/api_key
POE_API_KEY=

# ── Week 10: tracing with LangSmith ───────────────────────────────────────────
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=agentic-coding-fitness

# ── Weeks 14–15: knowledge-graph memory (local Docker services) ───────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
CHROMA_HOST=localhost

# ── Week 17: an OpenAI-compatible gateway for the ADK agents (optional) ───────
# The agents default to AUTHMD_PROVIDER / ONBOARDING_PROVIDER = alto, which needs YOUR gateway below.
# No gateway? Set both providers to anthropic (uses ANTHROPIC_API_KEY) or gemini (uses GOOGLE_API_KEY).
ALTO_LLM_BASE_URL=
ALTO_LLM_API_KEY=
AUTHMD_PROVIDER=anthropic
ONBOARDING_PROVIDER=anthropic

# ── Weeks 18–23: local / sovereign inference (optional; SIM mode works without) ─
# Any OpenAI-compatible endpoint: Ollama on this machine, or a DGX / DGX Spark you own.
EDGE_BASE_URL=http://localhost:11434/v1
EDGE_MODEL=
DGX_BASE_URL=
DGX_MODEL=
OLLAMA_MODEL=

# ── NVIDIA (weeks 16, 23, 25) ─────────────────────────────────────────────────
# build.nvidia.com hosted models (NeMo Agent Toolkit, NemoClaw fallbacks). https://build.nvidia.com
NVIDIA_API_KEY=
# NGC — NIM containers and nvcr.io pulls. https://ngc.nvidia.com/setup/api-key
NGC_API_KEY=
# Hugging Face — gated model downloads (weeks 19, 25). https://huggingface.co/settings/tokens
HF_TOKEN=

# ── Week 24: Jev (TypeSafe System One) ────────────────────────────────────────
# https://console.typesafe.ai/settings/keys  (week 24 also runs DRY with no key)
TYPESAFE_API_KEY=

# ── Week 25: your DGX Spark(s) — see week25_dgx_spark/.env.example for the full list ────
SPARK_HOST=
SPARK_HOST2=
