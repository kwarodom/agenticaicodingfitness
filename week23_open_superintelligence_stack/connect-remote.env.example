# Week 23 — connect this laptop to a remote DGX Spark over Tailscale.
#
# Copy to connect-remote.env and fill in YOUR Spark's tunnel URL, then:
#   source week23/connect-remote.env
#   .venv/bin/python week23/00_lab_runner/tutorial_server.py   # → http://127.0.0.1:8113
#
# Requires `tailscale up` and admission to the Spark's tailnet. Sanity check:
#   curl -s $DGX_TUNNEL_URL/models | head
#
# connect-remote.env itself is gitignored (it holds your private tailnet host).

export DGX_CONN=tunnel
export DGX_TUNNEL_URL=http://your-spark.your-tailnet.ts.net:11435/v1
# big models stream slower over the tunnel — give labs more headroom than the 150s default
export LAB_RUN_TIMEOUT=420
