  "sequence": {
    "title": "Lab 02 — discover → invoke → answer, live",
    "caption": "The agent reads the skill file first, then runs the genuine tool-call loop: the model decides the skill applies, queries telemetry, files the work order exactly as the SKILL.md instructs, and answers from the results.",
    "actors": [
      {"id": "user", "label": "You"},
      {"id": "agent", "label": "Agent loop (lab02)"},
      {"id": "skill", "label": "hotel-telemetry SKILL.md"},
      {"id": "model", "label": "Model endpoint"},
      {"id": "tools", "label": "Business tools"}
    ],
    "steps": [
      {"from": "user", "to": "agent", "label": "Room 1203 is reading 29.4°C — investigate", "kind": "call"},
      {"from": "agent", "to": "skill", "label": "DISCOVER — scan frontmatter (~55 tok)", "kind": "call"},
      {"from": "skill", "to": "agent", "label": "match → load body (~507 tok); other skill stays cold", "kind": "return"},
      {"from": "agent", "to": "model", "label": "system prompt + tool schema", "kind": "call"},
      {"from": "model", "to": "agent", "label": "ACT query_room_telemetry({'room': '1203'})", "kind": "return"},
      {"from": "agent", "to": "tools", "label": "execute tool", "kind": "call"},
      {"from": "tools", "to": "agent", "label": "OBSERVE temp 29.4 vs setpoint 23.0 · alarm HIGH_TEMP", "kind": "return"},
      {"from": "agent", "to": "model", "label": "observation → next decision", "kind": "call"},
      {"from": "model", "to": "agent", "label": "ACT file_work_order — per the SKILL.md", "kind": "return"},
      {"from": "agent", "to": "tools", "label": "execute → WO-4211 filed per SOP-HVAC-07", "kind": "call"},
      {"from": "agent", "to": "user", "label": "ANSWER · 2 tool hops in 38.2 s · $0.0000 sovereign", "kind": "return"},
      {"from": "agent", "to": "agent", "label": "same capability replays over MCP frames and an A2A task (lab03)", "kind": "note"}
    ]
  },
