      {"from": "jevlead", "to": "queue"},
      {"from": "jevrag", "to": "context"},
      {"from": "jevpt", "to": "gate"},
      {"from": "queue", "to": "sales", "label": "proposal"},
      {"from": "context", "to": "answer", "label": "labelled sections"},
