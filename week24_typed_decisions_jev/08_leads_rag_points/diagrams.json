    ],
    "nodes": [
      {"id": "lead", "label": "Inquiry", "lane": "input", "sub": "lab 08-1"},
      {"id": "passages", "label": "Access-filtered passages", "lane": "input", "sub": "tenant/project checked first · lab 08-2"},
      {"id": "point", "label": "BMS point description", "lane": "input", "sub": "lab 08-3"},
      {"id": "jevlead", "label": "solution · stage · scope", "lane": "jev", "accent": "green"},
      {"id": "jevrag", "label": "relevant · evidence · conflict · injection", "lane": "jev", "accent": "green"},
      {"id": "jevpt", "label": "kind · ambiguous", "lane": "jev", "accent": "green"},
      {"id": "queue", "label": "Sales queue + follow-up list", "lane": "code", "sub": "no_outreach", "accent": "amber"},
      {"id": "context", "label": "Context assembly", "lane": "code", "sub": "evidence | conflicting | excluded", "accent": "amber"},
      {"id": "gate", "label": "Accept or unknown", "lane": "code", "sub": "ambiguity gate — tune on data", "accent": "amber"},
      {"id": "sales", "label": "Sales engineer", "lane": "people"},
      {"id": "answer", "label": "Answering LLM", "lane": "people", "sub": "cites passage ids", "accent": "violet"},
      {"id": "curator", "label": "Curator + Brick/SHACL", "lane": "people", "sub": "graph_write: False", "accent": "violet"}
    ],
    "edges": [
      {"from": "lead", "to": "jevlead", "animated": true},
      {"from": "passages", "to": "jevrag", "animated": true},
