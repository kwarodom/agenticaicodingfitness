# Week 24 · Jev Lab — API keys template.
#
# Copy the lines you need into the repo-root .env (gitignored), or paste keys in the
# Jev Lab Runner's 🔑 Keys dialog (saves to week24/.env.local, also gitignored).
# Never commit real keys. Every lab also runs in DRY mode with no keys at all.

# Jev (TypeSafe) — makes the typed decisions. Get one: https://console.typesafe.ai/settings/keys
TYPESAFE_API_KEY=

# Pick ANY of these for the LLM that writes (Module 11). One is enough.
# Claude     https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# ChatGPT    https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Gemini     https://aistudio.google.com/apikey
GEMINI_API_KEY=
# DeepSeek   https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# Kimi       https://platform.moonshot.ai/console/api-keys
KIMI_API_KEY=
# GLM        https://z.ai/manage-apikey/apikey-list
ZAI_API_KEY=
# OpenRouter https://openrouter.ai/settings/keys  (one key, many models)
OPENROUTER_API_KEY=

# Optional overrides
# KIMI_BASE_URL=https://api.moonshot.cn/v1          # China-region Kimi account
# GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4 # China-region Zhipu account
# OLLAMA_BASE_URL=http://localhost:11434/v1         # local Ollama (no key needed)
# OLLAMA_MODEL=gemma4:latest
