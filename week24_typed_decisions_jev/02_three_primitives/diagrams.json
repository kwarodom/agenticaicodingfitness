    {
      "title": "Multi-label nouls are independent — they do not sum to 1",
      "type": "hbars",
      "unit": "p(true)",
      "labels": ["needs_hvac", "needs_housekeeping", "needs_billing", "needs_security"],
      "series": [
        {"name": "noul", "values": [0.97, 0.87, 0.98, 0.22], "color": "cyan"}
