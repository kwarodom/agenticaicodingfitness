        "from": "router",
        "to": "a_eng",
        "label": "chat → hosted_vllm (A)",
        "animated": true
      },
      {
        "from": "router",
        "to": "b_eng",
        "label": "chat → hosted_vllm (B)",
        "animated": true
      },
      {
        "from": "router",
        "to": "lap",
        "label": "fallback: laptop-fast"
      }
    ]
  },
  "sequence": {
    "title": "Lab 08-3 — one group, one Spark down: retry, then cooldown",
    "caption": "Measured on this Mac with no Spark configured (lab 03, Step 3). The alias one-spark-down has two deployments: Spark A's vLLM and the laptop's Ollama. Calls 1 and 2 landed on Spark A, failed, and were retried on the laptop (x-litellm-attempted-retries: 1); the client saw HTTP 200 both times. Spark A had now failed more than allowed_fails: 1, so the router put it in cooldown for 30 s, and calls 3–6 went straight to the laptop (retries 0).",
    "actors": [
      {
        "id": "client",
        "label": "lab03 (client)"
      },
      {
        "id": "gw",
        "label": "LiteLLM :4000"
      },
      {
        "id": "spark",
        "label": "Spark A vLLM :8000"
      },
      {
        "id": "laptop",
        "label": "laptop Ollama"
      }
    ],
    "steps": [
      {
        "from": "client",
        "to": "gw",
        "label": "call 1 · model=one-spark-down · Bearer master key",
        "kind": "call"
      },
      {
        "from": "gw",
        "to": "spark",
        "label": "shuffle picked Spark A",
        "kind": "call"
      },
      {
        "from": "spark",
        "to": "gw",
        "label": "connection error",
        "kind": "return"
      },
      {
        "from": "gw",
        "to": "laptop",
        "label": "num_retries: 1 → the group's other deployment",
        "kind": "call"
      },
      {
        "from": "laptop",
        "to": "gw",
        "label": "\"1\"",
        "kind": "return"
      },
      {
        "from": "gw",
        "to": "client",
        "label": "200 · attempted-retries: 1",
        "kind": "return"
      },
      {
        "from": "gw",
        "to": "gw",
