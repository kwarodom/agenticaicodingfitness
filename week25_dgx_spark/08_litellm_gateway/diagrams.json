{
  "architecture": {
    "title": "One gateway in front of every engine on both Sparks — and a laptop fallback",
    "caption": "Clients speak one OpenAI API to LiteLLM on :4000 and ask for an alias (chat, spark-a/vllm, laptop-fast …). The gateway checks the master key, picks a deployment (simple-shuffle across Spark A and Spark B for chat), retries or benches a failing one (allowed_fails, cooldown_time), and falls back to the laptop's Ollama when a whole alias is down. The engines themselves have no authentication, so keep their ports private and publish only :4000.",
    "lanes": [
      {
        "id": "clients",
        "label": "Clients"
      },
      {
        "id": "gw",
        "label": "LiteLLM proxy :4000"
      },
      {
        "id": "sparka",
        "label": "Spark A"
      },
      {
        "id": "sparkb",
        "label": "Spark B"
      },
      {
        "id": "laptop",
        "label": "Laptop"
      }
    ],
    "nodes": [
      {
        "id": "sdk",
        "label": "OpenAI SDK · curl · agents",
        "lane": "clients",
        "sub": "base_url=…:4000/v1 · Bearer sk-…",
        "accent": "green"
      },
      {
        "id": "auth",
        "label": "master key check",
        "lane": "gw",
        "sub": "os.environ/LITELLM_MASTER_KEY",
        "accent": "red"
      },
      {
        "id": "router",
        "label": "Router",
        "lane": "gw",
        "sub": "aliases · shuffle · retries · cooldown · fallbacks",
        "accent": "violet"
      },
      {
        "id": "a_eng",
        "label": "Ollama · vLLM · SGLang · TRT-LLM",
        "lane": "sparka",
        "sub": ":11434 :8000 :30000 :8355",
        "accent": "cyan"
      },
      {
        "id": "b_eng",
        "label": "Ollama · vLLM · SGLang · TRT-LLM",
        "lane": "sparkb",
        "sub": ":11434 :8000 :30000 :8355",
        "accent": "cyan"
      },
      {
        "id": "lap",
        "label": "Ollama :11434",
        "lane": "laptop",
        "sub": "gemma3:4b · nemotron-3-nano",
        "accent": "amber"
      }
    ],
    "edges": [
      {
        "from": "sdk",
        "to": "auth",
        "label": "POST /v1/chat/completions {model: chat}",
        "animated": true
      },
      {
        "from": "auth",
        "to": "router",
        "label": "401 if no key"
      },
