# Week 25 · DGX Spark — settings template.
#
# Easiest: start the Spark Lab Runner and use 🖥 Spark setup (saves to week25/.env.local, gitignored,
# mode 0600). Or copy the lines you need into week25/.env.local or the repo-root .env.
# Never commit real tokens. Every lab also runs in DRY mode with none of these set.

# ── your Spark(s): ssh targets (an alias from ~/.ssh/config, or user@host) ──
SPARK_HOST=spark-a
SPARK_HOST2=spark-b
# HTTP host for the serving labs. Leave empty to reuse the ssh host's name; set to localhost
# when you forward the ports with the ssh -L command from lab 01-3.
SPARK_API_HOST=
# Per-engine override, e.g. Ollama tunnelled to a different local port:
# SPARK_URL_OLLAMA=http://localhost:21434/v1

# ── tokens (only needed for gated models / NGC containers / hosted fallbacks) ──
# Hugging Face — gated models such as Llama. https://huggingface.co/settings/tokens
HF_TOKEN=
# NGC — NIM containers and nvcr.io pulls. https://ngc.nvidia.com/setup/api-key
NGC_API_KEY=
# build.nvidia.com — hosted Nemotron endpoints (NemoClaw / NAT fallbacks)
NVIDIA_API_KEY=
