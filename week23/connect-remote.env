# week20/connect-remote.env — point the tutorials at the AltoTech DGX Spark over Tailscale.
#
# Usage (on the laptop, from the repo root):
#     source week20/connect-remote.env
#     python week20/01_nemotron_models/tutorial_server.py   # → http://127.0.0.1:8100
#
# Prereq: this laptop must have Tailscale installed and be admitted to the
# tailnet `tail461566.ts.net`. See CONNECT_REMOTE.md for the one-time join steps.
# Auth is your Tailscale device identity (WireGuard) — no API key, no public exposure.

# tunnel = reach a DGX on another network (here: the Spark over the Tailscale mesh).
export DGX_CONN=tunnel

# The Spark's OpenAI-compatible Ollama endpoint, addressed by its MagicDNS name.
export DGX_TUNNEL_URL=http://spark-3b82.tail461566.ts.net:11434/v1

# Optional — pin a plain-content model for snappier, non-reasoning demos.
# The default auto-pick (nemotron-3-super:120b) streams a reasoning channel that
# the tutorial UI renders fine, but empties the OpenAI `content` field. llama3.3:70b
# and gemma4:latest return normal `content`. Uncomment to use one:
# export DGX_MODEL=llama3.3:70b

echo "week20 → DGX Spark: DGX_CONN=$DGX_CONN  DGX_TUNNEL_URL=$DGX_TUNNEL_URL${DGX_MODEL:+  DGX_MODEL=$DGX_MODEL}"
